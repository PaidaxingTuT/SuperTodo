<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- 顶部导航与操作栏 -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="超级清单"
            android:textColor="@color/widget_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_filter_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_tag_bg"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:text="全部事项"
            android:textColor="@color/widget_badge_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btn_widget_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="刷新小部件"
            android:padding="5dp"
            android:src="@drawable/widget_ic_refresh" />

        <ImageView
            android:id="@+id/btn_widget_settings"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="设置小部件"
            android:padding="5dp"
            android:src="@drawable/widget_ic_settings" />

        <ImageView
            android:id="@+id/btn_widget_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="添加事项"
            android:padding="5dp"
            android:src="@drawable/widget_ic_add" />
    </LinearLayout>

    <!-- 事项概览统计条 -->
    <TextView
        android:id="@+id/widget_count_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_header"
        android:layout_marginTop="4dp"
        android:text="0 项待办 · 0 项已完成"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp" />

    <!-- 事项列表 -->
    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_count_text"
        android:layout_marginTop="8dp"
        android:divider="@null"
        android:dividerHeight="5dp"
        android:scrollbars="none" />

    <!-- 空状态提示 -->
    <TextView
        android:id="@+id/widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_count_text"
        android:gravity="center"
        android:text="@string/widget_empty_text"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

</RelativeLayout>
