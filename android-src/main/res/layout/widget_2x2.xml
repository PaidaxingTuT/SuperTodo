<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_2x2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:id="@+id/widget_2x2_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_2x2_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="待办清单"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_2x2_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_tag_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="(0)"
            android:textColor="@color/widget_badge_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- 占位空白 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 设置按钮 -->
        <ImageView
            android:id="@+id/btn_2x2_settings"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="设置"
            android:padding="3.5dp"
            android:src="@drawable/widget_ic_settings" />
    </LinearLayout>

    <!-- 分割线 -->
    <TextView
        android:id="@+id/widget_2x2_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/widget_2x2_header"
        android:layout_marginTop="6dp"
        android:background="@color/widget_stroke" />

    <!-- 底部操作按钮栏 -->
    <LinearLayout
        android:id="@+id/widget_2x2_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_2x2_expand"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tag_bg"
            android:gravity="center"
            android:text="展开清单"
            android:textColor="@color/widget_badge_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btn_2x2_complete"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_item_bg"
            android:gravity="center"
            android:text="完成"
            android:textColor="@color/widget_cost_color"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 中部主体：下一项待办: 内容 -->
    <LinearLayout
        android:id="@+id/widget_2x2_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_2x2_divider"
        android:layout_above="@id/widget_2x2_actions"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_2x2_hero_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="下一项待办:"
            android:textColor="@color/widget_primary"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_2x2_hero_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/widget_text_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_2x2_empty_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="已全部完成"
            android:textColor="@color/widget_cost_color"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</RelativeLayout>
