<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- 顶部导航与操作栏 -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="超级清单"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_filter_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_tag_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="全部事项"
            android:textColor="@color/widget_badge_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- 占位空白，使用 RemoteViews 允许的 TextView，严禁使用原生 View 避免触发 InflateException -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="0 项待办"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/btn_widget_settings"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="设置小部件"
            android:padding="4dp"
            android:src="@drawable/widget_ic_settings" />

        <ImageView
            android:id="@+id/btn_widget_add"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="添加事项"
            android:padding="4dp"
            android:src="@drawable/widget_ic_add" />
    </LinearLayout>

    <!-- 事项列表 -->
    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_header"
        android:layout_marginTop="8dp"
        android:divider="@null"
        android:dividerHeight="4dp"
        android:scrollbars="none" />

    <!-- 空状态提示 -->
    <TextView
        android:id="@+id/widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_header"
        android:gravity="center"
        android:text="@string/widget_empty_text"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 1x1 极简自适应模式（当被拖拽至 1x1 极小尺寸时自动展现） -->
    <LinearLayout
        android:id="@+id/widget_compact_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/compact_count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/widget_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/compact_label_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="待办事项"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

</RelativeLayout>
