                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- 象限小标题胶囊（置于上方正中间，点击打开应用四象限管理） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/qw_pill_bg"
                        android:gravity="center"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="重要不紧急"
                        android:textColor="@color/qw_q2_border"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/q2_empty"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="暂无事项"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/q2_items_box"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/q2_item_1"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/widget_item_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone">
                        <ImageView
                            android:id="@+id/q2_chk_1"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_marginEnd="7dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/widget_ic_check_box_unchecked" />
                        <TextView
                            android:id="@+id/q2_title_1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/widget_text_primary"
                            android:textSize="12.5sp" />
                        <TextView
                            android:id="@+id/q2_done_1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/widget_text_done"
                            android:textSize="12.5sp"
                            android:visibility="gone" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/q2_item_2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/widget_item_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone">
                        <ImageView
                            android:id="@+id/q2_chk_2"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_marginEnd="7dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/widget_ic_check_box_unchecked" />
                        <TextView
                            android:id="@+id/q2_title_2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/widget_text_primary"
                            android:textSize="12.5sp" />
                        <TextView
                            android:id="@+id/q2_done_2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/widget_text_done"
                            android:textSize="12.5sp"
                            android:visibility="gone" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/q2_item_3"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/widget_item_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone">
                        <ImageView
                            android:id="@+id/q2_chk_3"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_marginEnd="7dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/widget_ic_check_box_unchecked" />
                        <TextView
                            android:id="@+id/q2_title_3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/widget_text_primary"
                            android:textSize="12.5sp" />
                        <TextView
                            android:id="@+id/q2_done_3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/widget_text_done"
                            android:textSize="12.5sp"
                            android:visibility="gone" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/q2_item_4"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/widget_item_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:visibility="gone">
                        <ImageView
                            android:id="@+id/q2_chk_4"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_marginEnd="7dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/widget_ic_check_box_unchecked" />
                        <TextView
                            android:id="@+id/q2_title_4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/widget_text_primary"
                            android:textSize="12.5sp" />
                        <TextView
                            android:id="@+id/q2_done_4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/widget_text_done"
                            android:textSize="12.5sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- 十字深色坐标轴（位于四象限网格正中央） -->
    <!-- X 轴（水平分界线） -->
    <View
        android:id="@+id/qw_axis_x"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_centerVertical="true"
        android:background="@color/qw_axis_line" />

    <!-- Y 轴（垂直分界线） -->
    <View
        android:id="@+id/qw_axis_y"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:background="@color/qw_axis_line" />

    <!-- 四周方向提示纯文字（去掉胶囊背景） -->
    <!-- 上方：紧急 -->
    <TextView
        android:id="@+id/qw_pill_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="紧急"
        android:textColor="@color/qw_pill_text"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <!-- 下方：不紧急 -->
    <TextView
        android:id="@+id/qw_pill_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="不紧急"
        android:textColor="@color/qw_pill_text"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <!-- 左侧：不重要 -->
    <TextView
        android:id="@+id/qw_pill_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:gravity="center"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="不重要"
        android:textColor="@color/qw_pill_text"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <!-- 右侧：重要 -->
    <TextView
        android:id="@+id/qw_pill_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:gravity="center"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="重要"
        android:textColor="@color/qw_pill_text"
        android:textSize="10.5sp"
        android:textStyle="bold" />

</RelativeLayout>
